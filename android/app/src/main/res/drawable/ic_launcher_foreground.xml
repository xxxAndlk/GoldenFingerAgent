        android:strokeWidth="3"
        android:fillColor="#F5C24B"
        android:pathData="M49,30 c0,-3 2,-5 5,-5 s5,2 5,5 l0,12 c1,-1 3,-1 4,0 l2,1 c2,1 3,3 3,5 l0,2 c0,5 -4,9 -9,9 l-6,0 c-4,0 -7,-3 -7,-7 l0,-4 c0,-3 2,-6 5,-7 l2,-1 c1,-1 3,-1 4,0 z" />
