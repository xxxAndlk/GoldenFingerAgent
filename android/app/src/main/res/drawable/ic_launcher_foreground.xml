    <path
        android:fillColor="#FFF3C4"
        android:pathData="M46,36 a3,3 0 1,0 0,6 a3,3 0 1,0 0,-6 z" />
    <!-- 光芒（四角短线） -->
    <path
        android:strokeColor="#C9A227"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M54,14 L54,20 M78,30 L73,34 M30,30 L35,34 M54,92 L54,86" />
