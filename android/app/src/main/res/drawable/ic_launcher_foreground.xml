    <path
        android:fillColor="#F2D98C"
        android:pathData="M54,30 a18,18 0 1,0 0,36 a18,18 0 1,0 0,-36 z" />
    <!-- 灯座（深金） -->
    <path
        android:fillColor="#B8891F"
